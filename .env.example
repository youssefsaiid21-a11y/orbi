# Copy to .env. Supply your own LOCAL/development settings.
# No working provider credentials belong in this file.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/orbi?schema=public
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Flight search and natural-language interpretation
DUFFEL_API_KEY=
ZHIPU_API_KEY=

# Stripe TEST settings only
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Generate a separate 32-byte hex key: openssl rand -hex 32
PASSPORT_ENCRYPTION_KEY=
CRON_SECRET=

# Optional rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional notifications
RESEND_API_KEY=
ALERT_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Local administration / dedicated integration-test environment
ADMIN_LOCAL_MODE=false
ADMIN_LOCAL_PORT=3001
SMOKE_TEST_URL=http://localhost:3000
PRODUCT_AGENT_TEST_PASSWORD=
